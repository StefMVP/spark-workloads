# ------------------------------------------------------------------ cli
def alias(argv):
    """`spark train submit|map GROUP ...` is `spark job submit ...`: the router chooses the node, the group is dropped."""
    words = [i for i, word in enumerate(argv[:argv.index("--") if "--" in argv else len(argv)]) if word == "train"]
    if not words or len(argv) <= words[0] + 1:
        return
    at, verb = words[0], argv[words[0] + 1]
    head, rest = argv[:at], argv[at + 2:]
    if verb in ("submit", "map"):
        end = rest.index("--") if "--" in rest else len(rest)
        options, keep, skip = rest[:end], [], 0
        valued = {"--image", "--repo", "--ref", "--workspace", "--out", "--mem", "--cpus", "--env-file-secret", "--shards", "--as"}
        dropped_group = False
        for i, word in enumerate(options):
            if skip:
                skip -= 1
            elif word in ("--node", "--slots"):
                skip = 1
            elif word == "--pin":
                pass
            elif word in valued:
                keep += options[i:i + 2]; skip = 1
            elif not word.startswith("-") and not dropped_group:
                dropped_group = True
            else:
                keep.append(word)
        warn("`spark train` is now `spark job submit`: the router chooses the node; the group argument is ignored")
        argv[:] = head + ["job", "submit"] + keep + rest[end:]
    elif verb in ("status", "logs", "cancel"):
        argv[:] = head + ["job", verb] + rest


def require_runtime(find=None):
    """Every spark entry point runs under the interpreter of this script's header. Another one is refused before any effect."""
    import importlib.util
    missing = [name for name in ("yaml", "pydantic") if (find or importlib.util.find_spec)(name) is None]
    if missing:
        die(f"this Python ({sys.executable}) lacks {', '.join(missing)}; nothing was changed. "
            f"Run `spark ...` or `{ROOT / 'tools/cluster'} ...` (its header names the interpreter), not `python3 tools/cluster`")


def main():
    require_runtime()
    P = argparse.ArgumentParser(prog="spark", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    P.add_argument("--as", dest="as_", help="who is placing work (default $SPARK_AS or user@host)")
    S = P.add_subparsers(dest="cmd_name", required=True)

    def sub(parent, name, fn, help):
        p = parent.add_parser(name, help=help); p.set_defaults(fn=fn)
        p.add_argument("--as", dest="as_", default=argparse.SUPPRESS); return p

    sys.path.insert(0, str(ROOT / "tools/lib"))
    import clusterprofile
    clusterprofile.register(sys.modules[__name__], S)
    import studioidle
    studioidle.register(sys.modules[__name__], S)
    import switch
    switch.register(sys.modules[__name__], S)
    import sparkutil
    sparkutil.register(sys.modules[__name__], S)
    import sparkclean
    sparkclean.register(sys.modules[__name__], S)

    L = S.add_parser("layout", help="show or set how the ring is carved").add_subparsers(required=True)
    p = sub(L, "show", cmd_layout_show, "current layout, or the options for SPEC"); p.add_argument("spec", nargs="?")
    p = sub(L, "set", cmd_layout_set, "apply SPEC"); p.add_argument("spec"); p.add_argument("--pick", type=int, help="option number from `layout show SPEC`")
    p = sub(S, "status", cmd_status, "per-node holder, jobs, GPU, memory, containers"); p.add_argument("--json", action="store_true")
    p = sub(S, "claim", cmd_claim, "hold a group"); p.add_argument("group"); p.add_argument("--for", dest="purpose", required=True); p.add_argument("--force", action="store_true")
    p = sub(S, "release", cmd_release, "drop the hold on a group (refused while it has live jobs)"); p.add_argument("group"); p.add_argument("--force", action="store_true")

    import visionjob
    visionjob.register(sys.modules[__name__], S)
    p = sub(S, "cancel", cmd_cancel, "ask a model job of a native profile to stop (router jobs: spark job cancel)"); p.add_argument("id")

    alias(sys.argv)
    argv, tail = sys.argv[1:], []
    if "--" in argv:  # everything after -- is the job's command, never parsed as options
        i = argv.index("--"); argv, tail = argv[:i], argv[i + 1:]
    a = P.parse_args(argv)
    if hasattr(a, "cmd"):
        a.cmd = (a.cmd or []) + tail
    try:
        a.fn(a)
    except clusterprofile.Pending as error:
        print(f"spark: {error}", file=sys.stderr)
        raise SystemExit(3)
    except clusterprofile.Refused as error:
        die(str(error))


if __name__ == "__main__":
    main()
