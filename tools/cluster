def group_of(st, g) -> list[str]:
    g = g if g.startswith("s") else "s" + g
    if g not in st["layout"]["groups"]:
        die(f"no group {g} in the current layout ({', '.join(st['layout']['groups']) or 'none'}). `spark layout show`")
    return st["layout"]["groups"][g]


