# ------------------------------------------------------------------ ssh
def ssh(node: str, cmd: str, timeout=60, input=None) -> subprocess.CompletedProcess:
    if node not in NODE:
        die("configure SPARK_INVENTORY before host access")
    return subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", node, cmd],
                          capture_output=True, text=True, timeout=timeout, input=input)


def pmap(fn, items):
    items = list(items)
    with ThreadPoolExecutor(max(1, len(items))) as ex:
        return dict(zip(items, ex.map(fn, items)))


# ------------------------------------------------------------------ topology
def ring_path(members) -> list[str]:
    """Members in cable order (a path for 2-3 nodes, the ring for 4); None if they are not contiguous on the ring."""
    m = set(members)
    if len(m) == 4:
        return RING[:]
    for s in range(4):
        seq = [RING[(s + i) % 4] for i in range(len(m))]
        if set(seq) == m:
            return seq
    return None


def gname(members) -> str:
    return "s" + "".join(sorted(n[-1] for n in members))


def neighbours(a, b) -> bool:
    return (RING.index(a) - RING.index(b)) % 4 in (1, 3)


def hcas_toward(node, members) -> list[str]:
    i = RING.index(node)
    out = []
    if RING[(i + 1) % 4] in members and RING[(i + 1) % 4] != node:
        out += HCA_NEXT
    if RING[(i - 1) % 4] in members and RING[(i - 1) % 4] != node:
        out += HCA_PREV
    return list(dict.fromkeys(out))


def ring_ip(src, dst) -> str:
    return NODE[src]["ring_ips"][dst][0]


def parse_spec(spec: str):
    """'2x2' -> sizes [2,2]; '12,3,4' / 's12,s3,s4' / 'spark1+spark2,spark3' -> explicit groups."""
    spec = spec.strip().lower()
    if re.fullmatch(r"[1-4](x[1-4])*", spec):
        sizes = [int(x) for x in spec.split("x")]
        if sum(sizes) > 4:
            die(f"{spec}: {sum(sizes)} nodes, the ring has 4")
        return sizes, None
    groups = []
    for g in spec.split(","):
        g = g.strip().removeprefix("s") if not g.strip().startswith("spark") else g.strip()
        mem = [x if x.startswith("spark") else f"spark{x}" for x in (g.split("+") if "+" in g else list(g))]
        if any(x not in RING for x in mem):
            die(f"unknown node in '{g}'")
        groups.append(mem)
    flat = [x for g in groups for x in g]
    if len(flat) != len(set(flat)):
        die("a node appears in two groups")
    for g in groups:
        if not ring_path(g):
            die(f"{'+'.join(g)} is not contiguous on the ring (no cable between "
                f"{' and '.join(x for x in g if not any(neighbours(x, y) for y in g if y != x)) or 'some members'}); "
                "valid pairs: spark1+2, spark2+3, spark3+4, spark4+1")
    return None, groups


def carvings(sizes):
    """Every distinct way to cut the ring into contiguous groups of these sizes (order-insensitive)."""
    seen, out = set(), []
    for perm in dict.fromkeys(itertools.permutations(sizes)):
        for s in range(4):
            seq = [RING[(s + i) % 4] for i in range(4)]
            groups, k = [], 0
            for n in perm:
                groups.append(seq[k:k + n]); k += n
            key = frozenset(frozenset(g) for g in groups)
            if key not in seen:
                seen.add(key); out.append([ring_path(g) for g in groups])
    return out


def caveat(members) -> str:
    n = len(members)
    if n == 3:
        p = ring_path(members)
        return f"path {'-'.join(p)}: {p[0]} and {p[-1]} have no cable -> no tensor-parallel; pipeline/sharded only"
    return {1: "single node", 2: "ring neighbours, 2 rails", 4: "full ring, 4 rails per node"}[n]


# ------------------------------------------------------------------ per-group files on the nodes
def node_env(g, members, node) -> dict:
    path = ring_path(members)
    env = {"SPARK_GROUP": g, "SPARK_NODES": " ".join(NODE[m]["lan_ip"] for m in path),
           "SPARK_WORLD": str(len(path)), "SPARK_RANK": str(path.index(node)),
           "MASTER_ADDR": NODE[path[0]]["lan_ip"], "MASTER_PORT": "29500",
           "SPARK_HOSTFILE": "/spark/hostfile"}
    if len(path) > 1:  # subset of cluster/nccl/nccl-ring.env: only the rails cabled to this group's members
        env.update({"NCCL_IB_HCA": "=" + ",".join(hcas_toward(node, members)), "NCCL_ALGO": "Ring",
                    "NCCL_IB_SUBNET_AWARE_ROUTING": "1", "NCCL_IB_MERGE_NICS": "0", "NCCL_SOCKET_IFNAME": "enP7s7",
                    "NCCL_NET": "IB", "NCCL_NET_PLUGIN": "none", "NCCL_IB_DISABLE": "0",
                    "GLOO_SOCKET_IFNAME": "enP7s7",     # else gloo gives its peers 127.0.0.1 (host network, live 2026-11-14)
                    "OMPI_MCA_btl_tcp_if_include": "enP7s7", "OMPI_MCA_oob_tcp_if_include": "enP7s7",
                    "UCX_NET_DEVICES": "enP7s7"})
    return env


def group_files(g, members, node) -> dict[str, str]:
    env = node_env(g, members, node)
    host_env = dict(env, SPARK_HOSTFILE=f"$HOME/spark/groups/{g}/hostfile")
    sh = ["# written by tools/cluster (spark layout set); source me: . ~/spark/groups/%s/env.sh" % g,
          "export CUDA_HOME=/usr/local/cuda NCCL_HOME=$HOME/nccl/build",
          "export LD_LIBRARY_PATH=$NCCL_HOME/lib:$CUDA_HOME/lib64:/usr/lib/aarch64-linux-gnu/openmpi/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"]
    sh += [f'export {k}="{v}"' for k, v in host_env.items()]
    hostfile = "".join(f"{NODE[m]['lan_ip']} slots=1\n" for m in ring_path(members))
    return {"env.sh": "\n".join(sh) + "\n", "docker.env": "".join(f"{k}={v}\n" for k, v in env.items()),
            "wrap": f"#!/bin/bash\n# per-rank launcher: each node sources its OWN env (NCCL_IB_HCA differs per node)\n"
                    f". $HOME/spark/groups/{g}/env.sh\nexec \"$@\"\n",
            "hostfile": hostfile, "group.json": json.dumps({"group": g, "members": ring_path(members),
                                                             "caveat": caveat(members)}, indent=1) + "\n"}






# ------------------------------------------------------------------ live node facts
PROBE = r"""
echo "MEM $(awk '/MemAvailable/{a=int($2/1048576)} /MemTotal/{t=int($2/1048576)} END{print a, t}' /proc/meminfo)"
echo "GPU $(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,power.draw --format=csv,noheader,nounits 2>/dev/null | tr -d ' ')"
nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits 2>/dev/null | sed 's/^/APP /'
docker ps --format 'CTR {{.Names}}|{{.Image}}|{{.Status}}' 2>/dev/null
"""


def probe(node) -> dict:
    try:
        r = ssh(node, PROBE, timeout=20)
    except subprocess.TimeoutExpired:
        return {"error": "timeout"}
    if r.returncode and not r.stdout:
        return {"error": (r.stderr.strip() or "ssh failed")[-80:]}
    f = {"apps_mib": 0, "ctrs": []}
    for line in r.stdout.splitlines():
        tag, _, rest = line.partition(" ")
        if tag == "MEM":
            f["avail"], f["total"] = map(int, rest.split())
        elif tag == "GPU":
            p = (rest.split(",") + ["", "", ""])[:3]
            f["util"], f["temp"], f["power"] = p
        elif tag == "APP":
            with contextlib.suppress(ValueError):
                f["apps_mib"] += int(rest.split(",")[1])
        elif tag == "CTR":
            f["ctrs"].append(rest.split("|"))
    return f




